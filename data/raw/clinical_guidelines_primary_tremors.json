                    "Reassurance",
                    "Relaxation techniques",
                    "Behavioral therapy / CBT",
                    "Skill training"
                ],
                "specific_advanced": [
                    "Propranolol 10-40 mg PRN",
                    "Short-term use only"
                ],
                "follow_up_monitoring": [
                    "Review as needed",
                    "Ensure no progression of tremor"
                ]
            }
        },
        {
