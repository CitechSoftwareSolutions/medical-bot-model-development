            "clinical_presentation": {
                "key_features": [
                    "Thin, watery discharge",
                    "Vaginal dryness",
                    "Itching, burning, dyspareunia",
                    "Postmenopausal"
                ]
            },
            "diagnostic_approach": {
                "investigations": [
                    "Clinical diagnosis",
                    "pH > 4.5",
                    "Vaginal atrophy on exam"
                ]
            },
            "management_plan": {
                "initial_conservative": [
                    "Vaginal moisturizers (regular use)",
                    "Lubricants for intercourse",
                    "Topical estrogen cream (as per guidelines)"
