    "global_red_flags": [
        "Foul smelling discharge with fever / pelvic pain",
        "Postmenopausal bleeding with discharge",
        "Severe lower abdominal pain",
        "Pregnancy with bleeding / discharge",
        "Suspected PID / tubo-ovarian abscess",
        "Immunocompromised patient with persistent symptoms",
        "Recurrent or persistent discharge not responding to treatment",
        "Ulcer, growth, or suspicious lesions"
    ],
    "clinical_best_practices": [
        "Take a thorough history and perform focused examination",
        "Use minimal, appropriate tests to reach diagnosis",
        "Treat based on most likely diagnosis",
        "Treat sexual partners when indicated",
        "Counsel on safe sex, hygiene, and prevention",
        "Follow-up to ensure symptom resolution and prevent recurrence",
        "Consider screening for other STIs"
    ],
    "disclaimer": "This chart is a guide only. Clinical judgment is essential. Early recognition and appropriate management improve outcomes in women."
