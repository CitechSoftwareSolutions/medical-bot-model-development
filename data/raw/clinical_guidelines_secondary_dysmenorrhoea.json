    "global_red_flags": [
        "Severe pain unrelieved by analgesics",
        "Sudden onset severe pelvic pain",
        "Fever >= 38C with pelvic pain",
        "Foul-smelling discharge",
        "Heavy bleeding with hemodynamic instability",
        "Suspected ectopic pregnancy",
        "Adnexal mass with suspected torsion",
        "Weight loss, night sweats, persistent systemic symptoms",
        "Postcoital bleeding / intermenstrual bleeding",
        "Palpable pelvic mass / nodularity",
        "Failure to improve after 3 months of appropriate treatment",
        "Severe anemia (Hb < 8 g/dL)",
        "Suspected malignancy"
    ],
    "clinical_best_practices": [
        "Take a thorough history and perform focused examination",
        "Use minimal, appropriate tests to reach diagnosis",
