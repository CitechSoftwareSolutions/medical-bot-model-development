{
    "document_metadata": {
        "title": "Guideline Based Management of Common and Red Flag Cases of Secondary Dysmenorrhoea: A Clinical Flow Chart Guide",
        "category": "Clinical Guidelines",
        "target_audience": "Healthcare Professionals"
    },
    "workflow_steps": [
        "1. Initial Approach: Establish rapport & privacy, Detailed history, Menstrual/sexual history, Medications & family history, Identify red flags",
        "2. Initial Evaluation: Physical examination, Pelvic examination (speculum + bimanual), Screen for anemia/BMI/vitals, Baseline investigations, Pregnancy test, Exclude pregnancy & STIs",
        "3. Diagnosis & Risk Stratification: Consider common causes, Use clinical features/exam/tests, Consider STI & malignancy risks, Identify complications, Rule out non-infectious causes",
        "4. Management & Follow-Up: Treat underlying cause, Individualize management, Address pain & associated symptoms, Counsel on adherence & lifestyle, Follow-up to assess response, Revise plan if persistent"
    ],
